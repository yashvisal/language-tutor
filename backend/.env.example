# backend/.env.local — copy this file to `.env.local` and fill in the values.
# Loaded by `agent.py`. The long form, with the bounds and the failure modes,
# is the environment section of `backend/README.md`.

# --- required ---
# LiveKit Cloud project websocket URL (wss://<project>.livekit.cloud)
LIVEKIT_URL=
# LiveKit API key
LIVEKIT_API_KEY=
# LiveKit API secret
LIVEKIT_API_SECRET=
# OpenAI key for the realtime model, STT, analyzer and translate
OPENAI_API_KEY=
# The ledger's HTTP actions (https://<deployment>.convex.site)
CONVEX_SITE_URL=
# Clerk machine secret key (ak_...) — mints the M2M token for /tutor/*
CLERK_WORKER_MACHINE_SECRET_KEY=

# --- optional, defaults shown in comments ---
# Target language the learner practises (es)
TUTOR_TARGET_LANG=
# The learner's anchor language (en)
TUTOR_ANCHOR_LANG=
# Language of the opening goal exchange: anchor | target (anchor)
TUTOR_GOAL_LANG=
# OpenAI Realtime model id (gpt-realtime-2.1)
TUTOR_REALTIME_MODEL=
# Reasoning effort for gpt-realtime-2* ids: minimal | low (minimal)
TUTOR_REALTIME_REASONING=
# Output audio speed multiplier (1.0)
TUTOR_REALTIME_SPEED=
# Realtime voice (marin)
TUTOR_REALTIME_VOICE=
# Minimum endpointing delay, seconds — must outlast the STT flush lag (1.2)
TUTOR_MIN_ENDPOINT_S=
# Maximum endpointing delay, seconds — patience mid-word-search (3.0)
TUTOR_MAX_ENDPOINT_S=
# Speech-to-text model (gpt-live-transcribe)
TUTOR_STT_MODEL=
# Text model behind corrections (gpt-5.6-luna)
TUTOR_ANALYZER_MODEL=
# Whether corrections run at all; false is published to the UI (true)
TUTOR_ANALYZER_ENABLED=
# Text model behind translation (gpt-5.6-luna)
TUTOR_TRANSLATE_MODEL=
# A hold this many seconds old ends the session, bounded 60s-4h (600)
TUTOR_HOLD_IDLE_S=
# Local development ONLY: 1 bills nothing; refuses to boot with TUTOR_ENV=production (0)
TUTOR_ALLOW_UNMETERED=
# Free string; only `production` means anything. Set it on the prod worker only.
TUTOR_ENV=
# Only for a Clerk instance on another host (https://api.clerk.com)
CLERK_API_URL=
