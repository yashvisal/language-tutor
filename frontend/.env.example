# frontend/.env.local — copy this file to `.env.local` and fill in the values.
# Names only here: every value comes from a provider's dashboard, and nothing
# in this file is a secret. The table in `frontend/README.md` is the long form.
# Required vars are read through `lib/env.ts`, so a missing one fails by name.

# LiveKit Cloud project websocket URL (wss://<project>.livekit.cloud)
LIVEKIT_URL=
# LiveKit API key, used to mint room tokens
LIVEKIT_API_KEY=
# LiveKit API secret, signs those tokens
LIVEKIT_API_SECRET=

# Clerk instance key for the browser (pk_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk server key, never exposed to the client (sk_...)
CLERK_SECRET_KEY=
# Where Clerk sends users to sign in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Where Clerk sends users to sign up
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Route after sign-in when there is no return path (/home)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
# Route after sign-up when there is no return path (/home)
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Which Convex deployment the CLI talks to (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
# Convex websocket URL the React client connects to (https://<deployment>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Deploy only — belongs on Vercel, not in .env.local: lets the build run
# `npx convex deploy --cmd "pnpm build"`. Generate it for the *production*
# deployment (Convex dashboard -> Settings -> Deploy keys).
# CONVEX_DEPLOY_KEY=

# No model keys here. Every OpenAI call is made by the agent worker (backend/).
# Vars that live on the Convex deployment, not in this file, are set with
# `npx convex env set`: CLERK_FRONTEND_API_URL, CLERK_JWT_KEY,
# TUTOR_WORKER_MACHINE_ID, TUTOR_LEDGER_MACHINE_ID,
# CLERK_WEBHOOK_SIGNING_SECRET. See frontend/README.md.
